<odoo>
    <record id="carrier_account_view_form" model="ir.ui.view">
        <field name="model">carrier.account</field>
        <field
            name="inherit_id"
            ref="delivery_carrier_account.carrier_account_view_form"
        />
        <field name="arch" type="xml">
            <sheet position="before">
                <header>
                    <field name="is_roulier" invisible="True" />
                    <button
                        name="sync_roulier_carriers"
                        invisible="not is_roulier or not id"
                        class="oe_highlight"
                        string="Sync Roulier Carriers"
                        type="object"
                    />
                </header>
            </sheet>
            <group position="after">
                <field name="is_roulier" invisible="True" />
                <h4 class="mt-4 mb-0">Roulier Properties</h4>
                <hr class="mt-2 mb-4" />
                <field
                    name="roulier_properties"
                    nolabel="1"
                    columns="2"
                    invisible="not is_roulier"
                    class="no-properties-edit"
                    showAddButton="True"
                />
            </group>
        </field>
    </record>
</odoo>
